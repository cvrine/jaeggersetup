[Unit]
Description=Servico de Provisionamento Wi-Fi e Produto
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
ExecStart=/usr/bin/python3 /opt/iot_config/app.py
WorkingDirectory=/opt/iot_config
StandardOutput=inherit
StandardError=inherit
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target